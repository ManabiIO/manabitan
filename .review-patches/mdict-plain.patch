@@ -0,0 +1,57 @@
+/* Copyright (C) 2026 Manabitan Authors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+import assert from 'node:assert/strict';
+import {test} from 'node:test';
+import {createMdxImportData} from '../../ext/js/dictionary/mdx/mdx-converter.js';
+import {makeMdictFixture} from './mdict-binary-fixture.js';
+
+/**
+ * @param {string} definition
+ * @param {string} [format]
+ * @returns {Promise<{tag: string, data: {tag: string, class: string}, content: unknown[]}>}
+ */
+async function convert(definition, format = 'Html') {
+    const fixture = makeMdictFixture([{key: 'plain', value: definition}], {compression: 'zlib', format, recordBlockSize: 37});
+    const {files} = await createMdxImportData('plain.mdx', {}, fixture.bytes, []);
+    const rows = JSON.parse(new TextDecoder().decode(files.get('term_bank_1.json')));
+    assert.equal(rows.length, 1);
+    return rows[0][5][0].content;
+}
+
+for (const text of [
+    '',
+    'ordinary text',
+    '日本語 😀 𠮷 カタカナ',
+    ' \t\n\v\f whitespace \n ',
+    'quotes " and \' and a > b',
+    'a\ufeffb',
+    'long日本語'.repeat(10000),
+]) {
+    test(`plain MDict definition preserves text: ${JSON.stringify(text.slice(0, 40))}`, async () => {
+        assert.deepEqual(await convert(text), {
+            tag: 'div',
+            data: {tag: 'div', class: 'mdict-yomitan-content'},
+            content: text.length === 0 ? [] : [text],
+        });
+    });
+}
+for (const [definition, expected] of [
+    ['a &amp; b &#x41; &#65; &lt; c', 'a & b A A < c'],
+    ['a\r\nb\rc', 'a\nb\nc'],
+    ['a\0b', 'ab'],
+    ['<!-- comment -->text', 'text'],
+    ['a < b', 'a < b'],
+]) {
+    test(`parser-only MDict normalization: ${JSON.stringify(definition)}`, async () => {
+        assert.deepEqual((await convert(definition)).content, [expected]);
+    });
+}
+test('HTML elements are still converted into structured nodes', async () => {
+    const root = await convert('<b>bold</b>tail');
+    assert.deepEqual(root.content, [{tag: 'span', style: {fontWeight: 'bold'}, content: ['bold']}, 'tail']);
+});
+test('Format=Text keeps literal markup in a preformatted element', async () => {
+    const root = await convert('<b> &amp; literal', 'Text');
+    assert.deepEqual(root.content, [{tag: 'div', style: {whiteSpace: 'pre-wrap'}, content: ['<b> &amp; literal']}]);
+});
