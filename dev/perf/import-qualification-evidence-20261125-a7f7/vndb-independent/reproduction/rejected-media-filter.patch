+    /**
+     * Projected references have no presentation target to update. Keep the
+     * first occurrence of each new path before copying diagnostic keys; the
+     * ordinary sink still owns admission and first-reference error ordering.
+     * Target-bearing rows remain in their original order and are not filtered.
+     * @template {{imagePaths?: string[]}} T
+     * @param {T[]} mediaRows
+     * @param {ReadonlySet<string>} knownMediaPaths
+     * @returns {T[]}
+     */
+    _selectNewMediaReferenceRows(mediaRows, knownMediaPaths) {
+        /** @type {T[]} */
+        const selected = []
+        const newPaths = new Set()
+        for (const mediaRow of mediaRows) {
+            const {imagePaths} = mediaRow
+            if (typeof imagePaths === 'undefined') {
+                selected.push(mediaRow)
+                continue
+            }
+            /** @type {string[]|null} */
+            let selectedPaths = null
+            for (let i = 0; i < imagePaths.length; ++i) {
+                const path = imagePaths[i]
+                if (knownMediaPaths.has(path) || newPaths.has(path)) {
+                    selectedPaths ??= imagePaths.slice(0, i)
+                } else {
+                    newPaths.add(path)
+                    selectedPaths?.push(path)
+                }
+            }
+            if (selectedPaths === null) {
+                if (imagePaths.length > 0) { selected.push(mediaRow) }
+            } else if (selectedPaths.length > 0) {
+                selected.push({...mediaRow, imagePaths: selectedPaths})
+            }
+        }
+        return selected
+    }
+    /* eslint-enable @stylistic/semi */
