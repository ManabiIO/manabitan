diff --git a/ext/js/dictionary/term-bank-source-pipeline.js b/ext/js/dictionary/term-bank-source-pipeline.js
index 3cfc3bb..db7e348 100644
--- a/ext/js/dictionary/term-bank-source-pipeline.js
+++ b/ext/js/dictionary/term-bank-source-pipeline.js
@@ -615,0 +616,30 @@ export class TermBankSourcePipeline {
+    /* eslint-disable @stylistic/semi */
+    /**
+     * Starts one already-admitted compressed source during import setup. Charge
+     * any new archive materialization against the existing prefetch budget too.
+     * The pool keeps the read owned until its eventual consumer or cleanup.
+     * @param {number} startIndex
+     * @param {number} archiveMaterializationBytes
+     * @returns {{fileCount: number, estimatedBytes: number}}
+     */
+    prefetchCompressedFirst(startIndex, archiveMaterializationBytes) {
+        const none = {fileCount: 0, estimatedBytes: 0}
+        if (
+            !this._enabled || this._compressedReadPool === null ||
+            !Number.isSafeInteger(archiveMaterializationBytes) || archiveMaterializationBytes < 0 ||
+            archiveMaterializationBytes > this._prefetchMaxBytes
+        ) { return none }
+        const file = this._termFiles[startIndex]
+        if (typeof file === 'undefined') { return none }
+        const metadata = this._getCompressedSourceMetadata(file)
+        if (
+            metadata === null || metadata.uncompressedSize === 0 ||
+            Math.max(metadata.compressedSize, metadata.uncompressedSize) > this._prefetchMaxBytes - archiveMaterializationBytes
+        ) { return none }
+        // Observe speculative failure without replacing the cached rejection.
+        // The loader still validates and consumes the original result later.
+        void this._compressedReadPool.read(file).catch(() => {})
+        return {fileCount: 1, estimatedBytes: metadata.uncompressedSize}
+    }
+    /* eslint-enable @stylistic/semi */
+
diff --git a/test/term-bank-compressed-prefetch.test.js b/test/term-bank-compressed-prefetch.test.js
