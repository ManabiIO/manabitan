+import {build} from 'esbuild';
+import fs from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+
+const PARSER_WORKER = 'js/dictionary/term-bank-wasm-parser-worker.js';
+
+/**
+ * Creates a packaging-only extension snapshot. Worker source modules stay
+ * readable and unchanged in the checkout; the packaged worker keeps its URL.
+ * @param {string} extensionDirectory
+ * @returns {Promise<{directory: string, dispose: () => void}>}
+ */
+export async function stageBundledExtension(extensionDirectory) {
+    const sourceDirectory = path.resolve(extensionDirectory);
+    const bundled = await build({
+        absWorkingDir: sourceDirectory,
+        entryPoints: [PARSER_WORKER],
+        bundle: true,
+        format: 'esm',
+        platform: 'browser',
+        target: 'es2022',
+        write: false,
+        metafile: true,
+        legalComments: 'inline',
+    });
+    // A relative URL must retain its original base after inlining. Fail the
+    // build if a future dependency with import.meta moves across directories.
+    for (const file of Object.keys(bundled.metafile.inputs)) {
+        if (
+            path.dirname(file) !== path.dirname(PARSER_WORKER) &&
+            fs.readFileSync(path.join(sourceDirectory, file), 'utf8').includes('import.meta')
+        ) {
+            throw new Error(`Worker dependency has a different import.meta URL base: ${file}`);
+        }
+    }
+    if (bundled.outputFiles.length !== 1) {
+        throw new Error('Expected one self-contained parser worker bundle');
+    }
+    const directory = fs.mkdtempSync(path.join(os.tmpdir(), 'manabitan-package-'));
+    const dispose = () => { fs.rmSync(directory, {recursive: true, force: true}); };
+    try {
+        fs.cpSync(sourceDirectory, directory, {recursive: true});
+        fs.writeFileSync(path.join(directory, PARSER_WORKER), bundled.outputFiles[0].contents);
+        return {directory, dispose};
+    } catch (error) {
+        dispose();
+        throw error;
+    }
+}
