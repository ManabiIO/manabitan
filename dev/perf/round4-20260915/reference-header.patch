+                view.setUint32(offset + 4, blockOffsetHigh, true);
+                view.setUint32(offset + 8, compressedLength, true);
+                view.setUint32(offset + 12, uncompressedLength, true);
+                view.setUint32(offset + 16, entryOffset, true);
