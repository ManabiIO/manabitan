-            );
+            const offset = localIndex * RAW_TERM_CONTENT_COMPACT_BLOCK_REFERENCE_BYTES;
+            const entryOffset = packed.sourceChunkLocalOffsets[contentIndex];
+            if (blockIndex !== previousBlockIndex) {
+                // The ordinary writer validates the shared block tuple. Its
+                // encoded header can be reused for this synchronous block run.
+                writeRawTermContentCompactBlockReference(
+                    view, offset, blockOffsets[blockIndex], blockLengths[blockIndex],
+                    packedChunkLengths[blockIndex], entryOffset,
