diff --git a/test/term-bank-multibatch-admission.test.js b/test/term-bank-multibatch-admission.test.js
new file mode 100644
index 0000000..fbd07fc
--- /dev/null
+++ b/test/term-bank-multibatch-admission.test.js
@@ -0,0 +1,127 @@
+/*
