+    {name: 'inline table boundary', count: 64, kind: 'mixed', format: 2, sha256: '941a207bcf526fab94afccd1d3813a89db4c50308145b69d74e493ca9bb6d3f7'},
+    {name: 'odd compact columns', count: 65, kind: 'mixed', format: 2, sha256: 'bfc14d26eb02c71c301d29c7b6cf0a53902cedd865f99b34cfef2703f8796f5f'},
+    {name: 'ordinary array scores', count: 128, kind: 'array', format: 2, sha256: '031d1e93353b7a7baa31fc9bcc577ba5c7c760c6e39977b6595d5201d5a9ea00'},
+    {name: 'wide length at last row', count: 128, kind: 'wide', format: 1, sha256: '41bb459d750ecdeddbac08cdb289d98714a06469098f16669c8e2bbd43f5d8d3'},
+    {name: 'distinct-score fallback', count: 257, kind: 'unique', format: 1, sha256: '17c81d492b8ccc1312b655b134c683bba90e6d1bae08eb6db2b268ef7ee1248b'},
+    {name: 'row segment boundary', count: 30000, kind: 'mixed', format: 2, sha256: '12351a4861827df2a997011961b96966a164ca5e1b518329bfe620111c90d4b2'},
+    {name: 'last whole-index row count', count: 65534, kind: 'mixed', format: 2, sha256: '27cccc9679c4d0b902bf2c7e2bacafc4c7cced6a0dbdbc4d902c893b81613be3'},
+    {name: 'uint16 row sentinel', count: 65535, kind: 'mixed', format: 2, sha256: '11f331ba25dc4efc4c2c82d49a39e442de7be64b33797ffdcb804edb0d0dcc35'},
+    {name: 'wide score cardinality', count: 65536, kind: 'unique', format: 1, sha256: '6fe474816f5c5e544540ddceb72f3601f7e7e2b9cd93fdbaa69fefe0d9c01c7f'},
+    {name: 'fractional wide and negative-zero scores', count: 65, kind: 'float', format: 3, sha256: '5b5471e9d5a888cfeb6cc1633580e82ecb844ba79faddca041e90ee5a917e159'},
+    {name: 'float score beyond row count', count: 8, kind: 'tailFloat', format: 3, sha256: '3885a6f4e16ff92e9b51c66813e428a06d66553a4f34613b95d7b3a96e4f3abe'},
+    {name: 'fixed spans above 4 GiB', count: 65, kind: 'fixed', format: 2, sha256: 'a18f0182eb0bee2fca342b5887e70f5ac4b556b0153708ee9dfd845aadbcd034'},
+    {name: 'resolved duplicate content references', count: 65, kind: 'references', format: 2, sha256: 'd6d35ef1d07baeb893138131c178ef773003558b8dab62434aaafff6878fda0d'},
+]
