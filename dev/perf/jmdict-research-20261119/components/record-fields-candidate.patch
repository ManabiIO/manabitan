+const SCORE_VALUES = [-256, 255, 256, -257, -2147483648, 2147483647, 0]
+
+/** @typedef {'uniform'|'mixed'|'unique'|'float'|'array'|'tailFloat'|'wide'|'fixed'|'references'} VectorKind */
+/** @typedef {{name: string, count: number, kind: VectorKind, format: number, sha256: string}} Vector */
+
+// Exact output from develop d829f5b6e6a75ee8859d38d537d224ec33c4930e.
+// These freeze the persisted format independently of the new encoder.
+/** @type {Vector[]} */
+const vectors = [
+    {name: 'empty', count: 0, kind: 'uniform', format: 1, sha256: 'e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855'},
+    {name: 'equal-size fallback', count: 5, kind: 'uniform', format: 1, sha256: '7cf1373105686e8612bef232e9c31c64ef1b9796cfc10fc2e28469fc818d34fb'},
