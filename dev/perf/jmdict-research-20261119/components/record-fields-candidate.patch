+/**
+ * @typedef {object} ArtifactRecordFieldsPlan
+ * @property {boolean} compact
+ * @property {boolean} integerScores
+ * @property {number[]} scores
+ * @property {Map<number, number>} scoreIndexes
+ * @property {Uint16Array|null} inlineScoreIndexes
+ */
+
+/**
+ * Keeps only the score dictionary while content validation visits each row.
+ * The final offsets, lengths and score keys can then be written in place.
+ * This plan belongs to one synchronous run and must not cross an await.
+ * @param {number[]|Int32Array|Float64Array} scoreList
+ * @param {number} maximumRows
+ * @returns {ArtifactRecordFieldsPlan}
+ */
+function createArtifactRecordFieldsPlan(scoreList, maximumRows) {
+    const integerScores = scoreList instanceof Int32Array
+    return {
+        compact: true,
+        integerScores,
+        scores: [],
+        scoreIndexes: new Map(),
+        inlineScoreIndexes: integerScores && maximumRows >= COMPACT_SCORE_TABLE_MIN_ROWS ?
+            new Uint16Array(COMPACT_SCORE_TABLE_RADIUS * 2) :
+            null,
+    }
+}
+
+/**
+ * @param {ArtifactRecordFieldsPlan} plan
+ * @param {number} score
+ * @param {number} contentLength
+ */
+function addArtifactRecordFieldsPlanRow(plan, score, contentLength) {
+    if (!plan.compact) { return }
+    if (contentLength >= U16_NULL || (!plan.integerScores && !isLosslessInt32Score(score))) {
+        plan.compact = false
+        return
+    }
+    const inlineScore = score + COMPACT_SCORE_TABLE_RADIUS
+    const {inlineScoreIndexes, scoreIndexes, scores} = plan
+    const useInlineScore = inlineScoreIndexes !== null && inlineScore >= 0 && inlineScore < inlineScoreIndexes.length
+    const scoreIndex = useInlineScore ? inlineScoreIndexes[inlineScore] - 1 : (scoreIndexes.get(score) ?? -1)
+    if (scoreIndex >= 0) { return }
+    const nextIndex = scores.length
+    if (nextIndex >= U16_NULL) {
+        plan.compact = false
+        return
+    }
+    if (useInlineScore) {
+        inlineScoreIndexes[inlineScore] = nextIndex + 1
+    } else {
+        scoreIndexes.set(score, nextIndex)
+    }
+    scores.push(score)
+}
