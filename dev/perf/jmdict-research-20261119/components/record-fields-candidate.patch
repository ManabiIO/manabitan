+    /** @type {NonNullable<Parameters<TermRecordOpfsStore['_encodeAndAppendArtifactChunkForState']>[7]>} */
+    const indexes = new Map()
+    let start = 0
+    for (const count of counts) {
+        indexes.set(`${start}:${count}`, {
