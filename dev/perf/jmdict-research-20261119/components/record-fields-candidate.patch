+/**
+ * @param {Vector} vector
+ * @returns {{chunk: Parameters<TermRecordOpfsStore['_encodeArtifactRecordFields']>[0], offsets: Float64Array, lengths: number[], base: number}}
+ */
+function createVector({count, kind}) {
+    const base = 0x100000000 + 128
+    // Non-zero view offsets catch assumptions that a typed column owns its buffer.
+    const typedScores = new Int32Array(count + 4).subarray(2, count + 2)
+    for (let i = 0; i < count; ++i) {
+        typedScores[i] = kind === 'uniform' ? 7 : (kind === 'unique' ? i : SCORE_VALUES[i % SCORE_VALUES.length])
+    }
+    /** @type {number[]|Int32Array|Float64Array} */
+    let scoreList = typedScores
+    switch (kind) {
+        case 'array': {
+            scoreList = [...typedScores]
+            delete scoreList[17]
+
+            break
+        }
+        case 'float': {
+            const values = [1.5, 0, -0, 2147483648, 0.1, -2.25]
+            scoreList = Float64Array.from({length: count}, (_, i) => values[i % values.length])
+
+            break
+        }
+        case 'tailFloat': {
+            scoreList = new Float64Array(count + 1).fill(7)
+            scoreList[count] = 0.5
+
+            break
+        }
+    // No default
+    }
+    const offsets = Float64Array.from({length: count}, (_, i) => (i % 17 === 0 ? -1 : base + ((i * 73) % 199999)))
+    const lengths = Array.from({length: count}, (_, i) => [0, 1, 65534, -1][i % 4])
+    /** @type {Parameters<TermRecordOpfsStore['_encodeArtifactRecordFields']>[0]} */
+    const chunk = {rowCount: count, scoreList}
+    if (kind === 'wide') { lengths[count - 1] = 65535 }
+    if (kind === 'fixed') {
+        chunk.fixedContentOffsetBase = base
+        chunk.fixedContentLength = 7
+    }
+    if (kind === 'references') {
+        chunk.resolvedContentReferences = {
+            uniqueIndexList: Uint32Array.from({length: count}, (_, i) => i % 5),
+            offsets: new Float64Array([base + 64, base, base + 128, base + 32, base + 96]),
+            lengths: new Uint32Array([1, 0, 65534, 3, 8]),
+        }
+    }
+    return {chunk, offsets, lengths, base}
+}
+
+/**
+ * @param {Uint8Array} bytes
+ * @returns {string}
+ */
+function digest(bytes) {
+    return createHash('sha256').update(bytes).digest('hex')
+}
+
+/**
+ * @param {number} count
+ * @returns {Parameters<TermRecordOpfsStore['_encodeAndAppendArtifactChunkForState']>[1]}
+ */
+function createAppendChunk(count) {
+    const key = new TextEncoder().encode('語')
+    return {
+        dictionary: 'Record field encoding',
+        rowCount: count,
+        expressionBytesList: new Array(count).fill(key),
+        readingBytesList: new Array(count).fill(key),
+        readingEqualsExpressionList: new Uint8Array(count).fill(1),
+        scoreList: new Float64Array(count).fill(7),
+        sequenceList: new Int32Array(count).fill(-1),
+    }
+}
