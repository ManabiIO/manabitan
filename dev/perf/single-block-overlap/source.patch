diff --git a/test/zstd-single-block-overlap.test.js b/test/zstd-single-block-overlap.test.js
new file mode 100644
index 0000000..cb453ab
--- /dev/null
+++ b/test/zstd-single-block-overlap.test.js
@@ -0,0 +1,213 @@
+/*
