diff --git a/ext/js/dictionary/term-bank-source-pipeline.js b/ext/js/dictionary/term-bank-source-pipeline.js
index cfe6bef5..2f76de3a 100644
--- a/ext/js/dictionary/term-bank-source-pipeline.js
+++ b/ext/js/dictionary/term-bank-source-pipeline.js
@@ -381,20 +381,32 @@ export class TermBankSourcePipeline {
     }
 
     /**
-     * Builds an import-wide plan over raw ZIP payloads only when every source
-     * has complete central-directory metadata required for exact validation.
+     * Builds a lazy raw-payload plan with complete validation metadata. On
+     * low-memory devices, limit it to the existing source-batch byte budget;
+     * larger devices retain the import-wide plan. The parser's independent
+     * source-size and worker-availability guards still apply.
      * @param {number} startIndex
      * @returns {{files: TermBankSourceFile[], loaders: Array<() => Promise<CompressedTermBankSource>>, estimatedByteLengths: number[]}|null}
      */
     createCompressedImportRunPlan(startIndex) {
-        if (!this._enabled || this._lowMemory || this._compressedReadPool === null) { return null; }
-        const files = this._termFiles.slice(startIndex);
+        if (!this._enabled || this._compressedReadPool === null) { return null }
+        const batch = this._lowMemory ? this.getBatchPlan(startIndex) : null
+        // Ordinary batching admits an oversized first file to make progress.
+        // That exception must never bypass the compressed parser's budget.
+        if (batch !== null && (
+            batch.unknownSizeCount > 0 || batch.estimatedBytes <= 0 ||
+            batch.estimatedBytes > this._batchMaxBytes
+        )) { return null }
+        const files = batch?.files ?? this._termFiles.slice(startIndex)
         if (files.length < 4) { return null; }
         /** @type {Array<{compressionMethod: 0|8, compressedSize: number, uncompressedSize: number, signature: number}>} */
         const metadata = [];
+        let compressedBytes = 0
         for (const file of files) {
             const value = this._getCompressedSourceMetadata(file);
             if (value === null) { return null; }
+            compressedBytes += value.compressedSize
+            if (this._lowMemory && compressedBytes > this._batchMaxBytes) { return null }
             metadata.push(value);
         }
         const estimatedByteLengths = metadata.map(({uncompressedSize}) => uncompressedSize);
