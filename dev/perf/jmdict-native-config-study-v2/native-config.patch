diff --git a/test/term-content-canonical-scan-header.test.js b/test/term-content-canonical-scan-header.test.js
new file mode 100644
index 00000000..58c5f17e
--- /dev/null
+++ b/test/term-content-canonical-scan-header.test.js
@@ -0,0 +1,194 @@
+/*
