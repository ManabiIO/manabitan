+ * along with this program.  If not, see <https://www.gnu.org/licenses/>.
+ */
+/* eslint @stylistic/semi: ["error", "never"] */
+
+import assert from 'node:assert/strict'
+import fs from 'node:fs/promises'
+import {test} from 'vitest'
+import {CANONICAL_SCAN_LAYOUT as layout} from '../ext/js/dictionary/term-content-canonical-layout.js'
+import {TermContentMetadataArena} from '../ext/js/dictionary/term-content-metadata-arena.js'
+
+const module = await WebAssembly.compile(await fs.readFile(new URL('../ext/lib/term-content-canonical-scan-v1.wasm', import.meta.url)))
+
+/**
+ * Call the production kernel directly so trap-visible state is observed before
+ * the JS owner can roll back the committed journal.
+ * @param {number} count
+ * @param {{trapAfter?: number, reserve?: boolean, denseCapacity?: number}} [options]
+ * @returns {{arena: TermContentMetadataArena, header: Uint32Array, config: Uint32Array, meta: Uint32Array, identity: Uint32Array, rows: Uint32Array, signatures: Uint32Array, scan: () => number}}
+ */
+function fixture(count, {trapAfter = 0, reserve = true, denseCapacity = count} = {}) {
+    const arena = new TermContentMetadataArena(denseCapacity, 2 ** Math.ceil(Math.log2(Math.max(8, count * 2))))
+    const buffer = arena.memory.buffer
+    const header = new Uint32Array(buffer, 1024, 7)
+    const config = new Uint32Array(buffer, 1088, 22)
+    const meta = new Uint32Array(buffer, layout.META, count * 4)
+    const identity = new Uint32Array(buffer, layout.IDENT, count)
+    const rows = new Uint32Array(buffer, layout.ROWS, count)
+    const signatures = new Uint32Array(buffer, layout.SIGS, count * 3)
+    const first = 5
+    const rowStart = 37
+    const baseOffset = 11
+    header.fill(0xfafafafa)
+    config.set([
+        arena.slots.byteOffset,
+        arena.slots.length,
+        arena.hash1.byteOffset,
+        arena.hash2.byteOffset,
+        arena.state.byteOffset,
+        arena.length.byteOffset,
+        arena.signaturePresent.byteOffset,
+        arena.signature1.byteOffset,
+        arena.signature2.byteOffset,
+        arena.signature3.byteOffset,
+        denseCapacity,
+        0,
+        count,
+        first,
+        first + count,
+        0,
+        rowStart,
+        baseOffset,
+        baseOffset + count * 4,
+        1,
+reserve ? 1 : 0,
+trapAfter,
+    ])
+    for (let i = 0; i < count; ++i) {
+        meta.set([i * 4, 4, i + 1, 0], i * 4)
+        identity[i] = first + i
+        rows[i] = rowStart + i
+        signatures.set([0xa0 + i, 0xb0 + i, 0xc0 + i], i * 3)
+    }
+    const scan = new WebAssembly.Instance(module, {env: {memory: arena.memory}}).exports.scan_canonical
+    assert.equal(typeof scan, 'function')
+    return {arena, header, config, meta, identity, rows, signatures, scan: /** @type {() => number} */ (scan)}
+}
+
+test.each([1, 2, 3])('native trap after insertion %i exposes the committed journal and exact header progress', (trapAfter) => {
+    const {arena, header, config, signatures, scan} = fixture(3, {trapAfter})
+    const originalConfig = new Uint32Array(config)
+    assert.throws(scan, WebAssembly.RuntimeError)
+    // journal, cursor, pending, exact, resolved, dense, reserved
+    assert.deepEqual([...header], [trapAfter, trapAfter, trapAfter - 1, 0, 0, trapAfter, 0])
+    assert.deepEqual(config, originalConfig)
+    const journal = new Uint32Array(arena.memory.buffer, layout.JOURNAL, trapAfter * 3)
+    for (let index = 0; index < trapAfter; ++index) {
+        const slot = journal[index * 3]
+        assert.equal(journal[index * 3 + 1], 0)
+        assert.equal(journal[index * 3 + 2], index)
+        assert.equal(arena.slots[slot], index + 1)
+        assert.equal(arena.hash1[index], index + 1)
+        assert.equal(arena.hash2[index], 0)
+        assert.equal(arena.length[index], 4)
+        assert.equal(arena.state[index], 2)
+        assert.equal(arena.signaturePresent[index], 1)
+        assert.deepEqual([arena.signature1[index], arena.signature2[index], arena.signature3[index]], [...signatures.subarray(index * 3, index * 3 + 3)])
+    }
+    assert.ok(arena.state.subarray(trapAfter).every((state) => state === 0))
+})
+
+test.each(['row', 'identity', 'source'])('late %s error preserves earlier journal entries and the original cursor boundary', (fault) => {
+    const {arena, header, config, meta, identity, rows, scan} = fixture(3)
+    if (fault === 'row') { rows[2] = 40 }
+    if (fault === 'identity') { identity[2] = 0 }
+    if (fault === 'source') { meta[8] = 0xffffffff - 10 }
+    const originalConfig = new Uint32Array(config)
+    assert.equal(scan(), fault === 'source' ? -3 : -2)
+    assert.deepEqual([...header], [2, fault === 'source' ? 3 : 2, 2, 0, 0, 2, 0])
+    assert.deepEqual(config, originalConfig)
+    assert.deepEqual([...arena.state], [2, 2, 0])
+    const journal = new Uint32Array(arena.memory.buffer, layout.JOURNAL, 6)
+    assert.equal(journal[2], 0)
+    assert.equal(journal[5], 1)
+    assert.equal(arena.slots[journal[0]], 1)
+    assert.equal(arena.slots[journal[3]], 2)
+})
+
+test('non-reserving scan publishes pending output without authoritative mutation', () => {
+    const {arena, header, config, scan} = fixture(3, {reserve: false})
+    const originalConfig = new Uint32Array(config)
+    assert.equal(scan(), 0)
+    assert.deepEqual([...header], [0, 3, 3, 0, 0, 0, 0])
+    assert.deepEqual(config, originalConfig)
+    assert.ok(arena.state.every((state) => state === 0))
+    assert.ok(arena.slots.every((slot) => slot === 0))
+    assert.deepEqual([...new Uint32Array(arena.memory.buffer, layout.OUT, 3)], [11, 15, 19])
+    assert.deepEqual([...new Uint32Array(arena.memory.buffer, layout.OUT + 5 * layout.MAX * 4, 3)], [0xffffffff, 0xffffffff, 0xffffffff])
+})
+
+test('invalid config initializes the header before returning without mutation', () => {
+    const {arena, header, config, scan} = fixture(3)
+    config[1] = 3
+    config[11] = 2
+    config[15] = 1
+    const originalConfig = new Uint32Array(config)
+    assert.equal(scan(), -1)
+    assert.deepEqual([...header], [0, 1, 0, 0, 0, 2, 0])
+    assert.deepEqual(config, originalConfig)
+    assert.ok(arena.state.every((state) => state === 0))
+})
+
+test('invalid hash-table index keeps the current cursor and an empty journal', () => {
+    const {arena, header, scan} = fixture(3)
+    arena.slots[1] = 4
+    assert.equal(scan(), -4)
+    assert.deepEqual([...header], [0, 1, 0, 0, 0, 0, 0])
+    assert.ok(arena.state.every((state) => state === 0))
+})
+
+test('capacity failure preserves the committed prefix without publishing the failed insertion', () => {
+    const {arena, header, scan} = fixture(3, {denseCapacity: 2})
+    assert.equal(scan(), -5)
+    assert.deepEqual([...header], [2, 3, 2, 0, 0, 2, 0])
+    assert.deepEqual([...arena.state], [2, 2])
+    const journal = new Uint32Array(arena.memory.buffer, layout.JOURNAL, 6)
+    assert.equal(journal[2], 0)
+    assert.equal(journal[5], 1)
+})
+
+test('resolved rows preserve the separate resolved and pending header counts', () => {
+    const {arena, header, scan} = fixture(3)
+    new Uint8Array(arena.memory.buffer, layout.FLAGS, 3)[0] = 1
+    assert.equal(scan(), 0)
+    assert.deepEqual([...header], [2, 3, 2, 0, 1, 2, 0])
+    assert.deepEqual([...arena.hash1], [2, 3, 0])
+})
+
+test('exact descriptor boundary stops before the next row and resumes from the original cursor', () => {
+    const {arena, header, config, meta, rows, scan} = fixture(4097, {denseCapacity: 1})
+    arena.hash1[0] = 1
+    arena.state[0] = 1
+    arena.length[0] = 4
+    arena.slots[1] = 1
+    config[11] = 1
+    for (let row = 0; row < 4097; ++row) { meta[row * 4 + 2] = 1 }
+    // An invalid next row must remain unobserved until the next native call.
+    rows[4096] = 0xffffffff
+    assert.equal(scan(), 1)
+    assert.deepEqual([...header], [0, 4096, 0, 4096, 0, 1, 0])
+    const exact = new Uint32Array(arena.memory.buffer, layout.EXACT, 4096 * 2)
+    assert.deepEqual([...exact.subarray(0, 2)], [0, 0])
+    assert.deepEqual([...exact.subarray(-2)], [4095, 0])
+    config[15] = 4096
+    assert.equal(scan(), -2)
+    assert.deepEqual([...header], [0, 4096, 0, 0, 0, 1, 0])
+    rows[4096] = 37 + 4096
+    assert.equal(scan(), 0)
+    assert.deepEqual([...header], [0, 4097, 0, 1, 0, 1, 0])
+    assert.deepEqual([...new Uint32Array(arena.memory.buffer, layout.EXACT, 2)], [4096, 0])
+})
