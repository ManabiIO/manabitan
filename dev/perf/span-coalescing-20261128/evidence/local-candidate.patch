+function createSource(length, alignment = 0) {
+    const source = new Uint8Array(new SharedArrayBuffer(length + alignment + 8), alignment, length)
+    for (let i = 0; i < source.length; ++i) { source[i] = (i * 23 + (i >>> 4)) & 0xff }
+    return source
