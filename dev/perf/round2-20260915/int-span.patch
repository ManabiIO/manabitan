+static int parse_int32_span(
+    const uint8_t* src,
+    uint32_t len,
+    uint32_t start,
+    int32_t null_value,
+    int32_t* out_value,
+    uint32_t* out_end
+) {
+    if (start >= len) { return 0; }
+    uint32_t i = start;
+    int32_t result;
+    if (len - i >= 4u && is_null_token(src, i, 4u)) {
+        i += 4u;
+        result = null_value;
+    } else {
+        const int negative = src[i] == '-';
+        if (negative) { ++i; }
+        if (i >= len || src[i] < '0' || src[i] > '9') { return 0; }
+        const int leading_zero = src[i] == '0';
+        const uint32_t digits_start = i;
+        uint32_t value = 0u;
+        while (i < len && src[i] >= '0' && src[i] <= '9') {
+            const uint32_t digit = (uint32_t)(src[i] - '0');
+            if (value > 214748364u ||
+                (value == 214748364u && digit > (negative ? 8u : 7u))) { return 0; }
+            value = value * 10u + digit;
+            ++i;
+        }
+        if (leading_zero && i - digits_start != 1u) { return 0; }
+        result = negative ? (int32_t)(0u - value) : (int32_t)value;
+    }
+    /* Do not accept a valid prefix of a malformed or non-integer token. */
+    if (i < len && src[i] != ',' && src[i] != ']' && src[i] != '}' && !is_ws(src[i])) { return 0; }
+    *out_value = result;
+    *out_end = i;
+    return 1;
+}
