+describe('WASM sixteen-byte fastloop match copies', () => {
+    test.each([15, 16, 17, 23, 31, 32, 33, 39, 40, 41, 63, 64, 65, 127, 257, 32768])('preserves exact forward expansion for distance %i with fastloop slack', (distance) => {
+        for (const length of [3, 15, 16, 17, 31, 32, 33, 39, 40, 41, 63, 79, 80, 81, 127, 159, 160, 161, 239, 240, 241, 257, 258]) {
+            for (const padding of [0, 1, 7, 15]) {
+                const fixture = fixedMatch(distance, length, padding, 400)
+                expect(inflateRawSync(fixture.compressed).equals(Buffer.from(fixture.expected))).toBe(true)
+                const result = inflate(fixture.compressed, fixture.expected)
+                expect(result.status).toBe(fixture.expected.length)
+                expect(Buffer.from(result.output).equals(Buffer.from(fixture.expected))).toBe(true)
+            }
+        }
+    })
+
+    test.each([15, 16, 17, 31, 32, 33, 39, 40, 41, 257, 32768])('keeps the final output inside physical WASM memory for distance %i', (distance) => {
+        for (const length of [3, 31, 39, 40, 41, 79, 80, 81, 239, 240, 241, 258]) {
+            const {compressed, expected} = fixedMatch(distance, length, 7, 400)
+            wasm.wasm_reset_heap()
+            const input = wasm.wasm_alloc(compressed.length)
+            const metadata = wasm.wasm_alloc(20)
+            const spans = wasm.wasm_alloc(8)
+            wasm.wasm_alloc(expected.length + 65536)
+            const heap = new Uint8Array(wasm.memory.buffer)
+            const output = heap.byteLength - expected.length
+            expect(output - 16).toBeGreaterThan(spans + 8)
+            heap.set(compressed, input)
+            heap.fill(0xa5, output - 16)
+            new Uint32Array(wasm.memory.buffer, metadata, 5).set([0, compressed.length, expected.length, 8, crc32(expected)])
+            const status = wasm.inflate_and_join_term_banks(input, compressed.length, metadata, metadata + 4, metadata + 8, metadata + 12, metadata + 16, 1, output, expected.length, spans)
+            expect(status).toBe(expected.length)
+            expect([...heap.subarray(output - 16, output)]).toEqual(new Array(16).fill(0xa5))
+            expect(Buffer.compare(heap.subarray(output), expected)).toBe(0)
+        }
+    })
+})
