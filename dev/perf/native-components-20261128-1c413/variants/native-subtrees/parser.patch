+            normalization_hint, text_normalization_hint, MAX_JSON_NESTING);
+    }
+    return parse_composite_span_core(src, len, start, out_end, media_hint,
+        normalization_hint, text_normalization_hint, 1, MAX_JSON_NESTING);
+}
