+/**
+ * @param {number} hash
+ * @returns {number}
+ */
+function avalanche(hash) {
+    hash ^= hash >>> 15;
+    hash = Math.imul(hash, 2246822519) >>> 0;
+    hash ^= hash >>> 13;
+    hash = Math.imul(hash, 3266489917) >>> 0;
+    hash ^= hash >>> 16;
+    return hash >>> 0;
+}
