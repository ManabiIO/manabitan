+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program.  If not, see <https://www.gnu.org/licenses/>.
+ */
+
+import {afterEach, describe, expect, test, vi} from 'vitest';
+import {copyStableBytes} from '../ext/js/core/copy-stable-bytes.js';
+
+const LENGTHS = [0, 1, 3, 4, 7, 15, 31, 32, 33, 1023, 1024, 1025, 1055, 1056, 65535, 65536, 65537, 4 * 1024 * 1024 + 3];
+
+describe('stable shared-byte copies', () => {
+    afterEach(() => { vi.unstubAllGlobals(); });
+
+    test.each(LENGTHS)('preserves every byte, boundary and ownership at length %i', (length) => {
+        for (const shared of [false, true]) {
+            for (let alignment = 0; alignment < 8; ++alignment) {
+                const backing = shared ? new SharedArrayBuffer(length + 32) : new ArrayBuffer(length + 32);
+                const whole = new Uint8Array(backing);
+                whole.fill(165);
+                const source = new Uint8Array(backing, 8 + alignment, length);
+                for (let i = 0; i < length; ++i) { source[i] = (i * 131 + Math.floor(i / 256)) & 255; }
+                const expected = source.slice();
+                const result = copyStableBytes(source);
+                expect(result).toEqual(expected);
+                expect(result.buffer).toBeInstanceOf(ArrayBuffer);
+                expect(result.buffer).not.toBe(backing);
+                expect(result.byteOffset).toBe(0);
+                expect(result.buffer.byteLength).toBe(length);
+                expect(source).toEqual(expected);
+                expect(whole[source.byteOffset - 1]).toBe(165);
+                expect(whole[source.byteOffset + length]).toBe(165);
+                source.fill(0);
+                expect(result).toEqual(expected);
+                result.fill(255);
+                expect(source.every((byte) => byte === 0)).toBe(true);
+            }
+        }
+    });
+
+    test('preserves integer bit patterns that would be NaNs if treated as floats', () => {
+        const source = new Uint8Array(new SharedArrayBuffer(4099), 3, 4096);
+        const view = new DataView(source.buffer, source.byteOffset, source.byteLength);
+        const patterns = [0xffffffff, 0x7f800001, 0x7ff00000, 0x7ff00001, 0xfff80001, 0x80000000, 0x00000001, 0x00000000];
+        for (let i = 0; i < source.byteLength; i += 4) { view.setUint32(i, patterns[(i / 4) % patterns.length], true); }
+        expect(copyStableBytes(source)).toEqual(source.slice());
+    });
+
+    test('owns bytes from a shared WASM view before reuse and memory growth', () => {
+        const memory = new WebAssembly.Memory({initial: 1, maximum: 2, shared: true});
+        const source = new Uint8Array(memory.buffer, 5, 4099);
+        for (let i = 0; i < source.length; ++i) { source[i] = i & 255; }
+        const expected = source.slice();
+        const result = copyStableBytes(source);
+        memory.grow(1);
+        new Uint8Array(memory.buffer).fill(0);
+        expect(result).toEqual(expected);
+    });
+
+    test('keeps the ordinary fallback when SharedArrayBuffer is unavailable', () => {
+        const source = new Uint8Array(4097).fill(127);
+        vi.stubGlobal('SharedArrayBuffer', void 0);
+        const result = copyStableBytes(source);
+        expect(result).toEqual(source);
+        expect(result.buffer).not.toBe(source.buffer);
+    });
+
+    test('keeps native detached ordinary-buffer errors', () => {
+        const source = new Uint8Array(4097);
+        structuredClone(source.buffer, {transfer: [source.buffer]});
+        expect(() => copyStableBytes(source)).toThrow(TypeError);
+    });
+});
