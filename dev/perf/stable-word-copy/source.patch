diff --git a/test/copy-stable-bytes.test.js b/test/copy-stable-bytes.test.js
new file mode 100644
index 0000000..d7f80d7
--- /dev/null
+++ b/test/copy-stable-bytes.test.js
@@ -0,0 +1,84 @@
+/*
