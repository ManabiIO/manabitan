+/**
+ * Copies bytes whose caller guarantees are stable until this function returns.
+ * Integer loads avoid per-byte shared-memory copy overhead for large borrowed
+ * parser slabs. This is not an atomic snapshot of a concurrently written slab.
+ * The result always owns an exact-sized, unshared buffer, as with Uint8Array.slice.
+ * @param {Uint8Array} source
+ * @returns {Uint8Array}
+ */
+export function copyStableBytes(source) {
+    const length = source.byteLength;
+    if (
+        length < 1024 || typeof SharedArrayBuffer === 'undefined' ||
+        !(source.buffer instanceof SharedArrayBuffer)
+    ) {
+        return source.slice();
+    }
+    const result = new Uint8Array(length);
+    const input = new DataView(source.buffer, source.byteOffset, length);
+    const output = new DataView(result.buffer);
+    let offset = 0;
+    const blockEnd = length - length % 32;
+    for (; offset < blockEnd; offset += 32) {
+        output.setUint32(offset, input.getUint32(offset, true), true);
+        output.setUint32(offset + 4, input.getUint32(offset + 4, true), true);
+        output.setUint32(offset + 8, input.getUint32(offset + 8, true), true);
+        output.setUint32(offset + 12, input.getUint32(offset + 12, true), true);
+        output.setUint32(offset + 16, input.getUint32(offset + 16, true), true);
+        output.setUint32(offset + 20, input.getUint32(offset + 20, true), true);
+        output.setUint32(offset + 24, input.getUint32(offset + 24, true), true);
+        output.setUint32(offset + 28, input.getUint32(offset + 28, true), true);
+    }
+    const wordEnd = length - length % 4;
+    for (; offset < wordEnd; offset += 4) {
+        output.setUint32(offset, input.getUint32(offset, true), true);
+    }
+    for (; offset < length; ++offset) {
+        result[offset] = source[offset];
+    }
+    return result;
+}
