+/* Keep the monotonic hints local while the immutable source is scanned. The
+ * internal callers supply separate metadata fields; publishing them together
+ * also preserves partial hints when malformed input ends the scan early. */
+static int parse_composite_span_impl(
+    const uint8_t* src,
+    uint32_t len,
+    uint32_t start,
+    uint32_t* out_end,
+    uint32_t* media_hint,
+    uint32_t* normalization_hint,
+    uint32_t* text_normalization_hint,
+    int validate_glossary_types
+) {
+    uint32_t media = media_hint != 0 ? *media_hint : 0u;
+    uint32_t normalization = normalization_hint != 0 ? *normalization_hint : 0u;
+    uint32_t text_normalization = text_normalization_hint != 0 ? *text_normalization_hint : 0u;
+    const int result = parse_composite_span_loop(
+        src, len, start, out_end,
+        media_hint != 0 ? &media : 0,
+        normalization_hint != 0 ? &normalization : 0,
+        text_normalization_hint != 0 ? &text_normalization : 0,
+        validate_glossary_types
+    );
+    if (media_hint != 0) { *media_hint = media; }
+    if (normalization_hint != 0) { *normalization_hint = normalization; }
+    if (text_normalization_hint != 0) { *text_normalization_hint = text_normalization; }
+    return result;
+}
+
 static int parse_composite_span(const uint8_t* src, uint32_t len, uint32_t start, uint32_t* out_end) {
     return parse_composite_span_impl(src, len, start, out_end, 0, 0, 0, 0);
 }
