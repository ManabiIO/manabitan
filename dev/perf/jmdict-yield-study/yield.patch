+
+    test('a failed sink drains its already-owned turn before cleanup', async () => {
+        const failure = new Error('sink failed')
+        const run = startImport({sink: (index) => {
+            if (index === 2) { throw failure }
+        }})
+        try {
+            await run.admitted.promise
+            await nextTask()
