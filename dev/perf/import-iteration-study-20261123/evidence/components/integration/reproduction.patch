diff --git a/test/term-record-validation-runs.test.js b/test/term-record-validation-runs.test.js
new file mode 100644
index 0000000000000000000000000000000000000000..6126b758c959cf19a47141c1f697130982a65525
--- /dev/null
+++ b/test/term-record-validation-runs.test.js
@@ -0,0 +1,234 @@
+/*
