+/* Copyright (C) 2026 Manabitan authors; SPDX-License-Identifier: GPL-3.0-or-later */
+
+/** @typedef {{memory: WebAssembly.Memory, media_input_pointer(): number, media_output_pointer(): number, inflate_media(size: number, decoded: number, method: number, signature: number): number}} MediaExports */
+/** @typedef {{decode(bytes: Uint8Array, decoded: number, method: number, signature: number): Uint8Array}} MediaInflater */
+export const MEDIA_INFLATE_MAX_BYTES = 256 * 1024;
+
+/**
+ * A separate capped module avoids borrowing a parser arena across async work.
+ * Resource/load errors are handled by the importer's existing ZIP fallback.
+ * @returns {Promise<MediaInflater>}
+ */
+export async function createMediaInflater() {
+    const response = await fetch(new URL('../../lib/media-inflate.wasm', import.meta.url));
+    if (!response.ok) { throw new Error('Unable to load bounded media inflater'); }
+    const {instance} = await WebAssembly.instantiate(await response.arrayBuffer());
+    const wasm = /** @type {MediaExports} */ (/** @type {unknown} */ (instance.exports));
+    const input = wasm.media_input_pointer();
+    const output = wasm.media_output_pointer();
+    return {
+        decode(bytes, decoded, method, signature) {
+            if (bytes.byteLength > MEDIA_INFLATE_MAX_BYTES || !Number.isSafeInteger(decoded) || decoded < 0 || decoded > MEDIA_INFLATE_MAX_BYTES ||
+                (method !== 0 && method !== 8) || !Number.isSafeInteger(signature) || signature < 0 || signature > 0xffffffff) {
+                throw new RangeError('Invalid bounded media inflate metadata');
+            }
+            const heap = new Uint8Array(wasm.memory.buffer);
+            heap.set(bytes, input);
+            const size = wasm.inflate_media(bytes.byteLength, decoded, method, signature);
+            if (size < 0) { throw new Error(`Invalid ZIP media payload (${size})`); }
+            return heap.slice(output, output + size);
+        },
+    };
+}
