+#include <stdint.h>
+#include <stddef.h>
+#define MEDIA_CAPACITY (256u * 1024u)
+static uint8_t media_input[MEDIA_CAPACITY];
+static uint8_t media_output[MEDIA_CAPACITY];
+void* memset(void* dest, int value, size_t count) {
+    uint8_t* bytes = dest;
+    for (size_t i = 0; i < count; ++i) { bytes[i] = (uint8_t)value; }
+    return dest;
+}
+void* memcpy(void* dest, const void* source, size_t count) {
+    uint8_t* output = dest; const uint8_t* input = source;
+    for (size_t i = 0; i < count; ++i) { output[i] = input[i]; }
+    return dest;
+}
+#define MINIZ_NO_MALLOC
+#define MINIZ_NO_STDIO
+#define MINIZ_NO_TIME
+#define MINIZ_NO_ARCHIVE_APIS
+#define MINIZ_NO_DEFLATE_APIS
+#define MINIZ_LITTLE_ENDIAN 1
+#define MINIZ_USE_UNALIGNED_LOADS_AND_STORES 1
+#include "vendor/miniz/miniz_tinfl.c"
+static uint32_t crc32_table[8][256];
+static uint32_t crc32_table_initialized = 0u;
+
+static uint32_t crc32_bytes(const uint8_t* data, uint32_t length) {
+    if (crc32_table_initialized == 0u) {
+        for (uint32_t i = 0u; i < 256u; ++i) {
+            uint32_t value = i;
+            for (uint32_t bit = 0u; bit < 8u; ++bit) {
+                value = (value >> 1u) ^ ((value & 1u) != 0u ? 0xedb88320u : 0u);
+            }
+            crc32_table[0][i] = value;
+        }
+        for (uint32_t slice = 1u; slice < 8u; ++slice) {
+            for (uint32_t i = 0u; i < 256u; ++i) {
+                const uint32_t value = crc32_table[slice - 1u][i];
+                crc32_table[slice][i] = (value >> 8u) ^ crc32_table[0][value & 0xffu];
+            }
+        }
+        crc32_table_initialized = 1u;
+    }
+
+    uint32_t crc = 0xffffffffu;
+    uint32_t offset = 0u;
+    while (length - offset >= 8u) {
+        const uint32_t first =
+            (uint32_t)data[offset] |
+            ((uint32_t)data[offset + 1u] << 8u) |
+            ((uint32_t)data[offset + 2u] << 16u) |
+            ((uint32_t)data[offset + 3u] << 24u);
+        const uint32_t second =
+            (uint32_t)data[offset + 4u] |
+            ((uint32_t)data[offset + 5u] << 8u) |
+            ((uint32_t)data[offset + 6u] << 16u) |
+            ((uint32_t)data[offset + 7u] << 24u);
+        crc ^= first;
+        crc =
+            crc32_table[7][crc & 0xffu] ^
+            crc32_table[6][(crc >> 8u) & 0xffu] ^
+            crc32_table[5][(crc >> 16u) & 0xffu] ^
+            crc32_table[4][crc >> 24u] ^
+            crc32_table[3][second & 0xffu] ^
+            crc32_table[2][(second >> 8u) & 0xffu] ^
+            crc32_table[1][(second >> 16u) & 0xffu] ^
+            crc32_table[0][second >> 24u];
+        offset += 8u;
+    }
+    while (offset < length) {
+        crc = (crc >> 8u) ^ crc32_table[0][(crc ^ data[offset++]) & 0xffu];
+    }
+    return ~crc;
+}
+
+
+uint32_t media_input_pointer(void) { return (uint32_t)(uintptr_t)media_input; }
+uint32_t media_output_pointer(void) { return (uint32_t)(uintptr_t)media_output; }
+/* Exact synchronous bounded-buffer decode. The caller owns this instance and
+ * copies the verified result before yielding; no source buffer escapes. */
+int32_t inflate_media(uint32_t compressed, uint32_t decoded, uint32_t method, uint32_t signature) {
+    if (compressed > MEDIA_CAPACITY || decoded > MEDIA_CAPACITY) { return -1; }
+    if (method == 0u) {
+        if (compressed != decoded) { return -3; }
+        memcpy(media_output, media_input, decoded);
+    } else if (method == 8u) {
+        tinfl_decompressor decoder;
+        tinfl_init(&decoder);
+        size_t consumed = compressed, produced = decoded;
+        const tinfl_status status = tinfl_decompress(&decoder, media_input, &consumed,
+            media_output, media_output, &produced, TINFL_FLAG_USING_NON_WRAPPING_OUTPUT_BUF);
+        if (status != TINFL_STATUS_DONE) { return -2; }
+        if (produced != decoded) { return -3; }
+        if (consumed != compressed) { return -6; }
+    } else { return -1; }
+    if (crc32_bytes(media_output, decoded) != signature) { return -4; }
+    return (int32_t)decoded;
+}
