+    if (
+        typeof ARRAY_BUFFER_BYTE_LENGTH_DESCRIPTOR?.get !== 'function' ||
+        !(scores instanceof Int32Array) || Object.getPrototypeOf(scores) !== Int32Array.prototype ||
+        !ArrayBuffer.isView(scores) || Object.hasOwn(scores, 'length') || Object.hasOwn(scores, 'buffer') ||
+        !(scores.buffer instanceof ArrayBuffer) || scores.length < count
+    ) { return null; }
+    try {
+        ARRAY_BUFFER_BYTE_LENGTH_DESCRIPTOR.get.call(scores.buffer);
+    } catch {
+        return null;
+    }
+    return scores;
