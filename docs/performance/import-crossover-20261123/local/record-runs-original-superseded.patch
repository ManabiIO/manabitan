+    const {offsets, lengths, scoreKeys, scores} = columns;
+    const {uniqueIndexList, offsets: sourceOffsets, lengths: sourceLengths} = references;
+    for (let start = 0; start < count;) {
+        const uniqueIndex = uniqueIndexList[start];
+        if (uniqueIndex >= sourceOffsets.length) {
+            throw new RangeError(`Invalid resolved term content reference index: ${uniqueIndex}`);
+        }
+        const sourceOffset = sourceOffsets[uniqueIndex];
+        const sourceLength = sourceLengths[uniqueIndex];
