+/**
+ * Keep the real 8192-entry dense directory and a valid first local entry, while
+ * avoiding allocation of the unused large image payloads.
+ * @param {{method?: 0|8, badCrc?: boolean, sizeDelta?: number, readGate?: Promise<void>, onRead?: () => void}} [options]
+ */
+function denseTagArchive({method = 8, badCrc = false, sizeDelta = 0, readGate, onRead} = {}) {
+    const archive = new SparseZipDirectory();
+    const filename = 'tag_bank_1.json';
+    setSparseZipNames(archive, (index) => index === 0 ? filename : void 0);
+    const content = new TextEncoder().encode('[["名詞","partOfSpeech",0,"noun",0]]');
+    const payload = method === 0 ? content : new Uint8Array(deflateRawSync(content));
+    const directory = new DataView(archive.directory.buffer);
+    directory.setUint16(10, method, true);
+    directory.setUint32(16, (crc32(content) ^ (badCrc ? 1 : 0)) >>> 0, true);
+    directory.setUint32(20, payload.length, true);
+    directory.setUint32(24, content.length + sizeDelta, true);
+    const removedBytes = packedLength - payload.length;
+    let position = 46 + filename.length;
+    for (let index = 1; index < count; ++index) {
+        directory.setUint32(position + 42, directory.getUint32(position + 42, true) - removedBytes, true);
+        position += 46 + filenameLength;
+    }
+    archive.directoryOffset -= removedBytes;
+    archive.archiveSize -= removedBytes;
+    new DataView(archive.tail.buffer).setUint32(92, archive.directoryOffset, true);
+    const local = new Uint8Array(30 + filename.length + payload.length);
+    const localHeader = new DataView(local.buffer);
+    localHeader.setUint32(0, 0x04034b50, true);
+    localHeader.setUint16(8, method, true);
+    localHeader.setUint16(26, filename.length, true);
+    local.set(new TextEncoder().encode(filename), 30);
+    local.set(payload, 30 + filename.length);
+    const directorySlice = archive.slice.bind(archive);
+    archive.slice = (start, end) => {
+        if (start !== 0) { return directorySlice(start, end); }
+        if (end !== local.length) { throw new Error(`Unexpected dense tag range: ${start}:${end}`); }
+        const blob = new Blob([local]);
+        const arrayBuffer = blob.arrayBuffer.bind(blob);
+        blob.arrayBuffer = async () => {
+            onRead?.();
+            await readGate;
+            return await arrayBuffer();
+        };
+        return blob;
+    };
+    return {archive, filename, content};
+}
