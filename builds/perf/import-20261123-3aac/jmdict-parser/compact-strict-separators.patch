 describe.each([false, true])('strict format-3 row grammar, columns=%s', (columns) => {
+    test('preserves every JSON whitespace combination around field separators', async () => {
+        const fields = ['"key"', '"reading"', 'null', '""', '-2', '["meaning"]', 'null', '"tag"']
+        const expected = (await parse(`[[${fields.join(',')}]]`, true, columns)).rows
+        for (const before of ['', ' ', '\t', '\r', '\n', ' \t\r\n ']) {
+            for (const after of ['', ' ', '\t', '\r', '\n', ' \t\r\n ']) {
+                const source = `[[${fields.join(`${before},${after}`)}]]`
+                expect((await parse(source, true, columns)).rows).toStrictEqual(expected)
+            }
+        }
+    })
+
+    test.each([0, 8, 11, 12, 31, 127, 0x80, 0xa0, 0x3000])('rejects non-JSON separator whitespace U+%i', async (code) => {
+        const fields = ['"key"', '"reading"', 'null', '""', '0', '["meaning"]', '1', '"tag"']
+        for (let field = 1; field < fields.length; ++field) {
+            const invalid = [...fields]
+            invalid[field] = String.fromCodePoint(code) + invalid[field]
+            await expect(parse(`[[${invalid.join(',')}]]`, true, columns)).rejects.toThrow()
+        }
+    })
