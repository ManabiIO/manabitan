diff --git a/ext/js/dictionary/wasm/term-bank-parser.c b/ext/js/dictionary/wasm/term-bank-parser.c
index d1b26c411..ebe5c49d1 100644
--- a/ext/js/dictionary/wasm/term-bank-parser.c
+++ b/ext/js/dictionary/wasm/term-bank-parser.c
@@ -1334,7 +1334,14 @@ static int reuse_validated_glossary(
 }
 
 static inline int next_format3_field(const uint8_t* src, uint32_t len, uint32_t* position) {
-    uint32_t i = skip_ws(src, len, *position);
+    const uint32_t current = *position;
+    // A compact separator has no whitespace on either side. The following
+    // field parser still validates its token, including unexpected controls.
+    if (current < len && len - current >= 2u && src[current] == ',' && src[current + 1u] > 0x20u) {
+        *position = current + 1u;
+        return 1;
+    }
+    uint32_t i = skip_ws(src, len, current);
     if (i >= len || src[i] != ',') { return 0; }
     i = skip_ws(src, len, i + 1u);
     if (i >= len) { return 0; }
