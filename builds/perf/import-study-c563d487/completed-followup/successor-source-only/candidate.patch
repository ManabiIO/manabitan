+/* Admit a glossary probe without changing the interner's authoritative key
+ * state. Every added equality scan is bounded by 32 raw token-body bytes. */
+static int adjacent_key_matches(
+    const uint8_t* src, const TermRowMeta* current, const TermRowMeta* previous
+) {
+    const uint32_t expression_length = current->expression_length;
+    if (expression_length >= 2u && expression_length <= 34u &&
+        expression_length == previous->expression_length && content_bytes_equal_between(
+            src, current->expression_start + 1u, src, previous->expression_start + 1u, expression_length - 2u)) {
+        return 1;
+    }
+    const uint32_t reading_length = current->reading_length;
+    if (reading_length <= 2u || reading_length > 34u || reading_length != previous->reading_length) { return 0; }
+    // Strict scanning has validated both quotes, so equal bounded bodies also
+    // establish raw token equality. This bypass applies only to reading admission.
+    if (reading_length == expression_length && content_bytes_equal_between(
+            src, current->reading_start + 1u, src, current->expression_start + 1u, reading_length - 2u)) {
+        return 0;
+    }
+    return content_bytes_equal_between(
+        src, current->reading_start + 1u, src, previous->reading_start + 1u, reading_length - 2u
+    );
+}
