#!/usr/bin/env python3
"""Three fixed cases on one host, with 16 independent children per case."""
import argparse
import json
import pathlib
from cohort_tools import CANDIDATE_C, assert_expected, check_diagnostic, checked_sources, child, identity, paired_summaries, runtime_receipt, schedule, sha, tooling_receipt

parser = argparse.ArgumentParser()
for name in ['baseline', 'candidate', 'fixtures', 'output']:
    parser.add_argument(name, type=pathlib.Path)
args = parser.parse_args()
for name in ['baseline', 'candidate', 'fixtures', 'output']:
    setattr(args, name, getattr(args, name).resolve())
args.output.mkdir(parents=True, exist_ok=True)
here = pathlib.Path(__file__).resolve().parent
baseline_identity, candidate_identity = checked_sources(args.baseline, args.candidate)
tooling = tooling_receipt(here)
runtime = runtime_receipt()
manifest_path = args.fixtures / 'manifest.json'
manifest_hash = sha(manifest_path)
manifest = json.loads(manifest_path.read_text())
review = json.loads((here / 'negative-control-protocol-review.json').read_text())
assert review['source']['candidateCSourceSha256'] == CANDIDATE_C
assert review['rejection']['minimumSlowdownPercentExclusive'] == 3
assert manifest['generatorSha256'] == tooling['hashes']['negative-fixtures.mjs']
assert manifest['node'] == runtime['node']
assert [case['id'] for case in manifest['cases']] == [1, 2, 3]
for case in manifest['cases']:
    assert case['rows'] == 20000 and len(case['banks']) == 2
    for bank in case['banks']:
        assert sha(args.fixtures / bank['rawFile']) == bank['rawSha256']
        assert sha(args.fixtures / bank['compressedFile']) == bank['compressedSha256']

plan = {'schema': 1, 'scope': 'Separate fixed synthetic failure-overhead cohort; one hosted runner, no parallel host workload; not complete-import or equivalence qualification',
    'pairedUnit': 'Sum of16 enclosing-component elapsed/CPU repetitions within one fresh Node child;2 complete excluded warmups; repetitions are not independent paired observations',
    'casesOrder': [1, 2, 3], 'schedulePerCase': schedule(), 'measuredObservationCount': 48,
    'excludedPreflights': 'One untimed baseline output-verification child and one untimed instrumented candidate child per case, no warmups',
    'baseline': baseline_identity, 'candidate': candidate_identity, 'runtime': runtime, 'tooling': tooling,
    'fixtureManifestSha256': manifest_hash, 'fixtureManifest': manifest, 'prospectiveReview': review,
    'cases': [], 'complete': False}
report_path = args.output / 'negative-result.json'
def save():
    report_path.write_text(json.dumps(plan, indent=2) + '\n')
def run_observation(case_id, label, root, diagnostic=False, verify_only=False):
    assert identity(args.baseline) == baseline_identity and identity(args.candidate) == candidate_identity
    assert tooling_receipt(here) == tooling and sha(manifest_path) == manifest_hash
    command = ['node', '--expose-gc', '--max-old-space-size=512', str(here / 'negative-screen.mjs'), str(case_id),
        '--source-root', str(root), '--fixtures-dir', str(args.fixtures)]
    if diagnostic:
        command.extend(['--diagnostic-wasm', str(args.output / 'diagnostic.wasm')])
    if verify_only:
        command.append('--verify-only')
    data = child(command, args.output / f'negative-case-{case_id}-{label}', emit_receipt=True)
    selected = candidate_identity if root == args.candidate else baseline_identity
    assert data['sourceRoot'] == str(root) and data['gitHead'] == selected['head'] and data['gitTree'] == selected['tree']
    assert data['caseId'] == case_id and data['node'] == runtime['node'] and data['complete']
    assert data['fixtureManifestSha256'] == manifest_hash and data['generatorSha256'] == manifest['generatorSha256']
    assert data['runnerSha256'] == tooling['hashes']['negative-screen.mjs']
    assert data['outputDigestSha256'] == tooling['hashes']['output-digest.mjs']
    assert data['diagnosticFieldsSha256'] == tooling['hashes']['diagnostic-fields.json']
    assert data['wasmSha256'] == (sha(args.output / 'diagnostic.wasm') if diagnostic else selected['wasmSha256'])
    excluded = diagnostic or verify_only
    assert data['excludedOnly'] == excluded and data['warmupPasses'] == (0 if excluded else 2)
    assert data['measuredRepetitions'] == (0 if excluded else 16)
    assert len(data['repetitions']) == (1 if excluded else 16)
    assert len(data['warmups']) == (0 if excluded else 2)
    assert data['flags'] == {} and data['validateGlossaryTypes'] is True
    assert data['perPassRows'] == 20000 and data['rows'] == 20000 * len(data['repetitions'])
    for key in ['elapsedMs', 'cpuMs', 'inflateMs', 'inflateCpuMs', 'parseMs', 'lookupMs', 'nativeParseMs', 'rows', 'indexBytes']:
        sequential_total = 0.0
        for item in data['repetitions']:
            sequential_total += float(item[key])
        assert data[key] == sequential_total, key
    for item in data['repetitions'] + data['warmups']:
        assert item['rows'] == 20000 and item['fusedAttempts'] == 1 and item['fusedFallbacks'] == 0
        assert item['glossaryReuseCount'] == item['recentContentDedupHitCount'] == item['crcReusedBytes'] == 0
        assert item['digest'] == data['digest'] and item['indexBytes'] == data['perPassIndexBytes']
    return data

save()
print('PREFIX_NEGATIVE_PLAN ' + json.dumps({k: v for k, v in plan.items() if k != 'cases'}, separators=(',', ':')), flush=True)
try:
    for fixture in manifest['cases']:
        case_id = fixture['id']
        record = {'id': case_id, 'name': fixture['name'], 'observations': [], 'complete': False}
        plan['cases'].append(record)
        save()
        baseline = run_observation(case_id, 'baseline-verification', args.baseline, verify_only=True)
        record['baselineVerification'] = baseline
        save()
        diagnostic = run_observation(case_id, 'diagnostic', args.candidate, diagnostic=True)
        check_diagnostic(diagnostic['diagnostic'])
        assert_expected(diagnostic['diagnostic'], fixture['expectedMechanics'], f'Negative case{case_id}')
        for key in ['digest', 'perPassRows', 'perPassIndexBytes', 'bankIdentities', 'flags']:
            assert diagnostic[key] == baseline[key], (case_id, key)
        record['diagnostic'] = diagnostic
        save()
        print('PREFIX_NEGATIVE_DIAGNOSTIC ' + json.dumps({'caseId': case_id, 'digest': diagnostic['digest'], 'counts': diagnostic['diagnostic']}, separators=(',', ':')), flush=True)
        for step in plan['schedulePerCase']:
            arm, pair = step['arm'], step['pair']
            data = run_observation(case_id, f'pair-{pair}-{arm}', args.candidate if arm == 'B' else args.baseline)
            for key in ['digest', 'perPassRows', 'perPassIndexBytes', 'bankIdentities', 'flags']:
                assert data[key] == baseline[key], (case_id, pair, arm, key)
            record['observations'].append({**step, 'result': data})
            save()
            print('PREFIX_NEGATIVE_OBSERVATION ' + json.dumps({'caseId': case_id, **step,
                **{key: data[key] for key in ['rows', 'digest', 'measuredRepetitions', 'elapsedMs', 'cpuMs', 'inflateMs', 'parseMs', 'lookupMs', 'nativeParseMs', 'maxWasmHeapBytes']}}, separators=(',', ':')), flush=True)
        summary = paired_summaries(record['observations'], ['elapsedMs', 'cpuMs', 'parseMs', 'nativeParseMs', 'lookupMs'])
        candidate = summary['candidate.elapsedMs']
        control = summary['identicalControl.elapsedMs']
        largest_control = max(abs(change) for change in control['pairedChangesPercent'])
        clear_slowdown = (candidate['medianPairedChangePercent'] > 3 and
            all(change > 0 for change in candidate['pairedChangesPercent']) and
            candidate['medianPairedChangePercent'] > largest_control)
        record.update(summary=summary, complete=True, prospectiveNegativeAssessment={
            'clearSlowdownRuleTriggered': clear_slowdown, 'largestAbsoluteControlChangePercent': largest_control,
            'decision': 'Hold/reject this exact candidate' if clear_slowdown else 'No clear rule-triggered slowdown; equivalence remains unqualified and ambiguous negatives remain a hold/limitation',
            'cpuRole': 'Descriptive corroboration only'})
        save()
        print('PREFIX_NEGATIVE_CASE_RESULT ' + json.dumps({'caseId': case_id, 'complete': True, 'summary': summary,
            'assessment': record['prospectiveNegativeAssessment']}, separators=(',', ':')), flush=True)
    assert sum(len(case['observations']) for case in plan['cases']) == 48
    plan['complete'] = True
    save()
    print('PREFIX_NEGATIVE_RESULT ' + json.dumps({'complete': True, 'observations': 48,
        'cases': [{'id': case['id'], 'summary': case['summary'], 'assessment': case['prospectiveNegativeAssessment']} for case in plan['cases']]}, separators=(',', ':')), flush=True)
except Exception as error:
    plan['error'] = str(error)
    save()
    print('PREFIX_NEGATIVE_FAILED ' + json.dumps({'complete': False, 'completedObservations': sum(len(case['observations']) for case in plan['cases']), 'error': str(error)}, separators=(',', ':')), flush=True)
    raise
