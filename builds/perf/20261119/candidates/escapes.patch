+            flags = 3;
             if (i + 1u >= len) { return 0; }
             const uint8_t escape = src[i + 1u];
             if (escape == 'u') {
@@ -561,13 +566,17 @@ static __attribute__((always_inline)) inline int parse_string_span(const uint8_t
         if (c < 0x20u) { return 0; }
         if (c == '"') {
             *out_end = i + 1u;
-            return 1;
+            return flags;
         }
         ++i;
     }
     return 0;
 }
 
+static __attribute__((always_inline)) inline int parse_string_span(const uint8_t* src, uint32_t len, uint32_t start, uint32_t* out_end) {
+    return parse_string_span_flags(src, len, start, out_end) != 0;
+}
