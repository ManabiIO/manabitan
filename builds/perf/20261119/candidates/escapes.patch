-static __attribute__((always_inline)) inline int parse_string_span(const uint8_t* src, uint32_t len, uint32_t start, uint32_t* out_end) {
+/* A successful string is 1 without escapes or 3 with escapes. Boolean-only
+ * callers discard the witness through the wrapper below, so their inlined
+ * scanners do not need to retain it. This is JSON syntax, not UTF-8 validation. */
+static __attribute__((always_inline)) inline int parse_string_span_flags(const uint8_t* src, uint32_t len, uint32_t start, uint32_t* out_end) {
     if (start >= len || src[start] != '"') { return 0; }
     uint32_t i = start + 1u;
+    int flags = 1;
     while (i < len) {
         while (i + 8u <= len) {
             uint64_t word;
@@ -540,6 +544,7 @@ static __attribute__((always_inline)) inline int parse_string_span(const uint8_t
         if (i >= len) { break; }
         uint8_t c = src[i];
