diff --git a/test/term-bank-experiments.test.js b/test/term-bank-experiments.test.js
index 9a8e549..46e340f 100644
--- a/test/term-bank-experiments.test.js
+++ b/test/term-bank-experiments.test.js
@@ -276,6 +276,70 @@ describe('term-bank experiment defaults', () => {
 })
 
 describe('native exceptional keys', () => {
+    test.each([false, true])('keeps string escape witnesses local to each field, row and bank (native escapes=%s)', async (nativeEscapes) => {
+        const tokens = [
+            ['"plain-0"', '"reading-0"'],
+            [String.raw`"x\u65e5"`, '"plain-reading"'],
+            ['"plain-2"', String.raw`"y\u65e5"`],
+            ['"plain-3"', '"reading-3"'],
+            [String.raw`"\u0061"`, String.raw`"\u0061"`],
+            ['"a"', String.raw`"\u0061"`],
+            [String.raw`"\u0061"`, '"a"'],
+            ['"plain-4"', '""'],
+            ['"plain-5"', '"reading-5"'],
+            [String.raw`"q\"uote"`, String.raw`"r\\ead"`],
+            ['"plain-6"', '"reading-6"'],
+            [String.raw`"\uD800"`, String.raw`"\uDC00"`],
+            ['"plain-final"', '"reading-final"'],
+        ]
+        for (const padding of [0, 7, 8, 15, 16]) {
+            const prefix = 'p'.repeat(padding)
+            const padded = tokens.map((pair) => pair.map((token) => (token === '""' ? token : `"${prefix}${token.slice(1)}`)))
+            const rows = padded.map(([expression, reading], i) => `[${expression},${reading},"noun","",${i},["definition"],${i},""]`)
+            const sources = [rows.slice(0, 4), rows.slice(4, 8), rows.slice(8)].map((bank) => `[${bank.join(',')}]`)
+            const baseline = await parse(sources, {experimentalSkipFusedParse: true})
+            const result = await parse(sources, flags(nativeEscapes ? 11 : 9), true)
+            expect(result.rows).toEqual(baseline.rows)
+            const expected = padded.map(([expression, reading]) => {
+                const decodedExpression = /** @type {string} */ (JSON.parse(expression))
+                const decodedReading = /** @type {string} */ (JSON.parse(reading))
+                return {
+                    expression: [...encoder.encode(decodedExpression)],
+                    reading: [...encoder.encode(reading === '""' ? decodedExpression : decodedReading)],
+                    readingEqualsExpression: reading === '""' || reading === expression ? 1 : 0,
+                }
+            })
+            expect(result.rows.map(({expression, reading, readingEqualsExpression}) => ({expression, reading, readingEqualsExpression}))).toEqual(expected)
+            expect(result.profile.fusedParseAttempts).toBe(1)
+            expect(result.profile.fusedParseFallbacks).toBe(nativeEscapes ? 0 : 1)
+            expect(result.profile.escapedKeyDecodeCount).toBe(nativeEscapes ? 9 : 0)
+            if (!nativeEscapes) { expect(result.profile.discardedFusedRows).toBe(1) }
+        }
+    })
+
+    test('does not treat escapes in other fields as key escapes', async () => {
+        const sources = [
+            JSON.stringify([['literal', 'reading', 'tag"', 'rule\\', 0, ['line\nbreak'], 1, 'term\ttag']]),
+            JSON.stringify([['next', '', 'tag\\', '', 1, ['quote"', {type: 'text', text: 'other\ntext'}], 2, '']]),
+        ]
+        const baseline = await parse(sources, {experimentalSkipFusedParse: true})
+        const result = await parse(sources, flags(9), true)
+        expect(result.rows).toEqual(baseline.rows)
+        expect(result.profile.fusedParseAttempts).toBe(1)
+        expect(result.profile.fusedParseFallbacks).toBe(0)
+        expect(result.profile.escapedKeyDecodeCount).toBe(0)
+    })
+
