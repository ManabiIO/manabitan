+/* eslint @stylistic/semi: ["error", "never"] */
+
+import {readFile} from 'node:fs/promises'
+import {fileURLToPath} from 'node:url'
+import {crc32, deflateRawSync} from 'node:zlib'
+import {afterAll, beforeAll, describe, expect, test, vi} from 'vitest'
+import {
+    consumeLastTermBankWasmParseProfile,
+    inflateCompressedTermBankSourcesWasm,
+    parseTermBankWithWasmColumnChunks,
+} from '../ext/js/dictionary/term-bank-wasm-parser.js'
+
+const textEncoder = new TextEncoder()
+const nativeFetch = globalThis.fetch
+/** @typedef {{scores: number[], sequences: number[], content: number[], contentMetadata: number[], uniqueIndexes: number[]}} NumericSnapshot */
+
+beforeAll(() => {
+    vi.stubGlobal('fetch', async (/** @type {RequestInfo|URL} */ resource) => {
+        const url = resource instanceof URL ? resource : new URL(String(resource))
+        return url.protocol === 'file:' ?
+            new Response(await readFile(fileURLToPath(url))) :
+            await nativeFetch(resource)
+    })
+})
+
+afterAll(() => { vi.unstubAllGlobals() })
+
+/**
+ * Compare values and canonical content after independently inflating every
+ * source bank. The snapshots own their arrays before the next heap reset.
+ * @param {string[]} banks
+ * @param {boolean} [skipFused]
+ * @returns {Promise<{snapshot: NumericSnapshot, profile: ReturnType<typeof consumeLastTermBankWasmParseProfile>}>}
+ */
+async function parseBanks(banks, skipFused = false) {
+    const sources = banks.map((bank) => {
+        const source = textEncoder.encode(bank)
+        const bytes = Uint8Array.from(deflateRawSync(source))
+        return {
+            bytes,
+            compressionMethod: /** @type {const} */ (8),
+            compressedSize: bytes.byteLength,
+            uncompressedSize: source.byteLength,
+            signature: crc32(source),
+        }
+    })
+    const preloadedSource = await inflateCompressedTermBankSourcesWasm(sources)
+    /** @type {NumericSnapshot|undefined} */
+    let snapshot
+    await parseTermBankWithWasmColumnChunks(new Uint8Array(0), 3, (chunk) => {
+        expect(snapshot).toBeUndefined()
+        const base = chunk.contentBytesBaseOffset ?? 0
+        const length = chunk.contentBytesLength ?? chunk.contentMetaList?.reduce(
+            (maximum, value, index, values) => (index % 4 === 0 ? Math.max(maximum, value + values[index + 1]) : maximum),
+            0,
+        ) ?? 0
+        snapshot = {
+            scores: [...chunk.scoreList],
+            sequences: [...chunk.sequenceList],
+            content: [...(chunk.contentBytesBuffer?.subarray(base, base + length) ?? [])],
+            contentMetadata: [...(chunk.contentMetaList ?? [])],
+            uniqueIndexes: [...(chunk.contentUniqueIndexList ?? [])],
+        }
+    }, 2048, {
+        computeContentHashes: true,
+        emitContentSlab: true,
+        emitTokenBinaryContent: true,
+        useNativeStringPlan: true,
+        singleChunk: true,
+        experimentalSkipFusedParse: skipFused,
+        preloadedSource,
+    })
+    const profile = consumeLastTermBankWasmParseProfile()
+    if (typeof snapshot === 'undefined') { throw new Error('No parsed term-bank snapshot') }
+    return {snapshot, profile}
+}
+
+describe('fused numeric token bounds', () => {
+    test.each(['', ' ', '\t\r\n'])('preserves per-row numeric bounds across banks with whitespace %j', async (space) => {
+        const banks = [
+            `[["first","","","",${space}2147483647${space},["first"],${space}123456789${space},""],` +
+            `["second","","","",${space}-2147483648${space},["second"],${space}null${space},""]]`,
+            ' \n [] \r ',
+            `[["third","","","",${space}0${space},["third"]],` +
+            `["fourth","","","",${space}9${space},["fourth"],${space}-0${space},""],` +
+            `["fifth","","","",${space}-1${space},["fifth"],${space}2147483647${space},""]]`,
+        ]
+        const fused = await parseBanks(banks)
+        const generic = await parseBanks(banks, true)
+        expect(fused.snapshot).toStrictEqual(generic.snapshot)
+        expect(fused.snapshot.scores).toStrictEqual([2147483647, -2147483648, 0, 9, -1])
+        expect(fused.snapshot.sequences).toStrictEqual([123456789, -1, -1, 0, 2147483647])
+        expect(fused.profile?.fusedParseAttempts).toBe(1)
+        expect(fused.profile?.fusedParseFallbacks).toBe(0)
+    })
+
+    test.each([
+        ['-0', '4', -0, 4],
+        ['2147483648', '4', 2147483648, 4],
+        ['-2147483649', '4', -2147483649, 4],
+        ['1.0', '1e0', 1, 1],
+        ['2.5', '9007199254740991', 2.5, 9007199254740991],
+        ['1e2', '-2147483649', 100, -1],
+    ])('preserves late fallback for score %s and sequence %s', async (score, sequence, expectedScore, expectedSequence) => {
+        const banks = [
+            '[["before","","","",12345,["before"],987654321,""]]',
+            `[["fallback","","","", ${score}\t,["fallback"],\r${sequence}\n,""]]`,
+        ]
+        const fused = await parseBanks(banks)
+        const generic = await parseBanks(banks, true)
+        expect(fused.snapshot).toStrictEqual(generic.snapshot)
+        expect(fused.snapshot.scores).toStrictEqual([12345, expectedScore])
+        expect(fused.snapshot.sequences).toStrictEqual([987654321, expectedSequence])
+        expect(fused.profile?.fusedParseAttempts).toBe(1)
+        expect(fused.profile?.fusedParseFallbacks).toBe(1)
+    })
+
+    test.each(['01', '-01', '1e+', '1.', '+1', 'true', '1x', '-'])('rejects malformed numeric token %s after a valid bank', async (token) => {
+        for (const [score, sequence] of [[token, '2'], ['2', token]]) {
+            const banks = [
+                '[["before","","","",12345,["before"],987654321,""]]',
+                `[["invalid","","","", ${score} ,["invalid"], ${sequence} ,""]]`,
+            ]
+            await expect(parseBanks(banks)).rejects.toThrow(/parser failed/)
+            await expect(parseBanks(banks, true)).rejects.toThrow(/parser failed/)
+        }
+    })
+})
