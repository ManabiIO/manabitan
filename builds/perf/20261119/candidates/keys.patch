+/* eslint @stylistic/semi: ["error", "never"] */
+
+import {readFile} from 'node:fs/promises'
+import {fileURLToPath} from 'node:url'
+import {afterAll, beforeAll, describe, expect, test, vi} from 'vitest'
+import {encodePersistedTermLookupIndexFromPreinternedPlan} from '../ext/js/dictionary/term-lookup-index.js'
+import {
+    consumeLastTermBankWasmParseProfile,
+    copyWasmBackedColumnChunk,
+    parseTermBankWithWasmColumnChunks,
+} from '../ext/js/dictionary/term-bank-wasm-parser.js'
+
+const encoder = new TextEncoder()
+const decoder = new TextDecoder()
+const nativeFetch = globalThis.fetch
+
+/**
+ * @typedef {object} TermKeySnapshot
+ * @property {number} rowCount
+ * @property {string[]} strings
+ * @property {number[]} stringBytes
+ * @property {number[]} lengths
+ * @property {number[]} offsets
+ * @property {number[]} hashes
+ * @property {number[]} expressionIndexes
+ * @property {number[]} readingIndexes
+ * @property {number[]} readingEquals
+ * @property {number[]} scores
+ * @property {(number|undefined)[]} sequences
+ * @property {number[]|null} lookupBytes
+ * @property {string|null} lookupError
+ */
+/** @typedef {{profile: ReturnType<typeof consumeLastTermBankWasmParseProfile>, snapshot: TermKeySnapshot}} ParsedKeys */
+
+beforeAll(() => {
+    vi.stubGlobal('fetch', async (/** @type {RequestInfo|URL} */ resource) => {
+        const url = resource instanceof URL ? resource : new URL(String(resource))
+        return url.protocol === 'file:' ?
+            new Response(await readFile(fileURLToPath(url))) :
+            nativeFetch(resource)
+    })
+})
+
+afterAll(() => { vi.unstubAllGlobals() })
+
+/**
+ * @param {Uint8Array[]} sources
+ * @param {Parameters<typeof parseTermBankWithWasmColumnChunks>[4]} [options]
+ * @returns {Promise<ParsedKeys>}
+ */
+async function parseSources(sources, options = {}) {
+    /** @type {ReturnType<typeof copyWasmBackedColumnChunk>|null} */
+    let result = null
+    await parseTermBankWithWasmColumnChunks(
+        sources,
+        3,
+        (chunk) => { result = copyWasmBackedColumnChunk(chunk) },
+        1024,
+        {
+            computeContentHashes: true,
+            emitContentSlab: true,
+            emitTokenBinaryContent: true,
+            emitTermByteLists: false,
+            singleChunk: true,
+            experimentalFusedSingleBank: true,
+            experimentalNativeEscapedKeys: true,
+            ...options,
+        },
+    )
+    const profile = consumeLastTermBankWasmParseProfile()
+    if (result === null) { throw new Error('Expected parsed term-bank columns') }
+    const chunk = /** @type {ReturnType<typeof copyWasmBackedColumnChunk>} */ (result)
+    const plan = chunk.termRecordPreinternedPlan
+    const offsets = plan.stringOffsets
+    if (!(offsets instanceof Uint32Array) || !(plan.stringHashes instanceof Uint32Array)) {
+        throw new Error('Expected complete interned string metadata')
+    }
+    /** @type {number[]|null} */
+    let lookupBytes = null
+    /** @type {string|null} */
+    let lookupError = null
+    try {
+        lookupBytes = [...encodePersistedTermLookupIndexFromPreinternedPlan(
+            plan,
+            chunk.readingEqualsExpressionList,
+            chunk.sequenceList,
+            chunk.rowCount,
+        )]
+    } catch (error) {
+        if (!plan.stringLengths.includes(0) || !(error instanceof Error)) { throw error }
+        lookupError = error.message
+    }
+    return {
+        profile,
+        snapshot: {
+            rowCount: chunk.rowCount,
+            strings: Array.from(plan.stringLengths, (length, index) => decoder.decode(
+                plan.stringsBuffer.subarray(offsets[index], offsets[index] + length),
+            )),
+            stringBytes: [...plan.stringsBuffer],
+            lengths: [...plan.stringLengths],
+            offsets: [...offsets],
+            hashes: [...plan.stringHashes],
+            expressionIndexes: [...plan.expressionIndexes],
+            readingIndexes: [...plan.readingIndexes],
+            readingEquals: [...chunk.readingEqualsExpressionList],
+            scores: [...chunk.scoreList],
+            sequences: [...chunk.sequenceList],
+            lookupBytes,
+            lookupError,
+        },
+    }
+}
+
+/**
+ * @param {Array<[string, string]>} keys
+ * @returns {Uint8Array}
+ */
+function makeBank(keys) {
+    return encoder.encode(JSON.stringify(keys.map(([expression, reading], index) => [
+        expression, reading, '', '', index - 2, ['sense ' + index], index + 1, '',
+    ])))
+}
+
+/**
+ * @param {Uint8Array[]} sources
+ * @returns {Promise<ParsedKeys>}
+ */
+async function expectEstablishedPlan(sources) {
+    const fused = await parseSources(sources)
+    const established = await parseSources(sources, {experimentalSkipFusedParse: true, useNativeStringPlan: false})
+    expect(fused.snapshot).toStrictEqual(established.snapshot)
+    expect(fused.profile?.fusedParseAttempts).toBe(1)
+    expect(fused.profile?.fusedParseFallbacks).toBe(0)
+    return fused
+}
+
+describe('fused term-bank repeated key interning', () => {
+    test('preserves key order and row fields through spelling and reading runs across banks', async () => {
+        const first = makeBank([
+            ['同じ', 'おなじ'],
+            ['同じ', 'おなじ'],
+            ['同じ', 'おんなじ'],
+            ['同じ', 'おんなじ'],
+            ['同', 'おんなじ'],
+            ['同', 'おんなじ'],
+        ])
+        const second = makeBank([
+            ['同', 'おんなじ'],
+            ['同', 'おんなじ'],
+            ['別', 'べつ'],
+            ['同じ', 'おなじ'],
+            ['同じ', 'おなじ'],
+        ])
+        await expectEstablishedPlan([first, encoder.encode('[]'), second])
+    })
+
+    test('recomputes empty and equal-reading aliases for the current expression', async () => {
+        const {snapshot} = await expectEstablishedPlan([makeBank([
+            ['', ''],
+            ['', ''],
+            ['a', ''],
+            ['b', ''],
+            ['a', 'a'],
+            ['b', 'a'],
+            ['a', 'a'],
+            ['a', ''],
+            ['b', ''],
+        ])])
+        expect(snapshot.strings).toStrictEqual(['', 'a', 'b'])
+        expect(snapshot.readingEquals).toStrictEqual([1, 1, 1, 1, 1, 0, 1, 1, 1])
+        expect(snapshot.readingIndexes).toStrictEqual([0, 0, 1, 2, 1, 1, 1, 1, 2])
+        expect(snapshot.lookupError).toBe('Invalid term lookup index key boundary')
+    })
+
+    test('retains escaped and literal key identity while preserving disabled-decoder fallback', async () => {
+        const source = encoder.encode(String.raw`[
+            ["\u732b","\u306d\u3053","","",0,["one"],1,""],
+            ["\u732b","\u306d\u3053","","",0,["two"],2,""],
+            ["猫","ねこ","","",0,["three"],3,""],
+            ["\\u732b","a\\b","","",0,["four"],4,""],
+            ["\\u732b","a\\b","","",0,["five"],5,""],
+            ["\ud840\udf07","よし","","",0,["six"],6,""],
+            ["\ud840\udf07","よし","","",0,["seven"],7,""]
+        ]`)
+        const fused = await expectEstablishedPlan([source])
+        const disabled = await parseSources([source], {experimentalNativeEscapedKeys: false})
+        expect(disabled.snapshot).toStrictEqual(fused.snapshot)
+        expect(disabled.profile?.fusedParseAttempts).toBe(1)
+        expect(disabled.profile?.fusedParseFallbacks).toBe(1)
+        expect(fused.snapshot.strings).toStrictEqual(['猫', 'ねこ', '\\u732b', 'a\\b', '𠌇', 'よし'])
+    })
+
+    test.each([1, 7, 8, 15, 16, 17, 31, 32, 255, 256, 257])(
+        'compares complete raw tokens around the %i-byte boundary',
+        async (length) => {
+            const repeated = 'x'.repeat(length)
+            const changed = repeated.slice(0, length - 1) + 'y'
+            await expectEstablishedPlan([makeBank([
+                [repeated, 'read'],
+                [repeated, 'read'],
+                [changed, 'read'],
+                [changed, 'read'],
+                [repeated, 'ready'],
+                [repeated, 'ready'],
+            ])])
+        },
+    )
+
+    test('normalizes repeated malformed UTF-8 through the established fallback', async () => {
+        const source = makeBank([['bad?key', 'read'], ['bad?key', 'read'], ['bad?key', 'read']])
+        for (let i = 0; i < source.length; ++i) {
+            if (source[i] === '?'.charCodeAt(0)) { source[i] = 0xff }
+        }
+        const fused = await parseSources([source])
+        const established = await parseSources([source], {experimentalSkipFusedParse: true, useNativeStringPlan: false})
+        expect(fused.snapshot).toStrictEqual(established.snapshot)
+        expect(fused.profile?.fusedParseFallbacks).toBe(1)
+        expect(fused.snapshot.strings).toStrictEqual(['bad�key', 'read'])
+    })
+
+    test.each([
+        '["key","read","","",00,["bad score"],2,""]',
+        '["key","read","","",0,["bad glossary"},2,""]',
+        String.raw`["key","read\q","","",0,["bad escape"],2,""]`,
+    ])('still validates every later row with repeated keys: %s', async (invalidRow) => {
+        const source = encoder.encode('[["key","read","","",0,["valid"],1,""],' + invalidRow + ']')
+        await expect(parseSources([source])).rejects.toThrow()
+    })
+
+    test('does not carry a prior-key witness across parser calls or truncated bank boundaries', async () => {
+        await expectEstablishedPlan([makeBank([['first', 'read'], ['first', 'read']])])
+        const {snapshot} = await expectEstablishedPlan([makeBank([['next', 'different'], ['next', 'different']])])
+        expect(snapshot.strings).toStrictEqual(['next', 'different'])
+        await expect(parseSources([
+            encoder.encode('[["next","different","","",0,["valid"],1,""],["next","differ'),
+            encoder.encode('ent","","",0,["invalid boundary"],2,""]]'),
+        ])).rejects.toThrow()
+    })
+})
