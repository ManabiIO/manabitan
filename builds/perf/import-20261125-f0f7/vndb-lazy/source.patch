+ * source batch; the original byte arena remains independent of logical names.
+ * @implements {DenseZipEntry}
+ */
+class DenseZipCatalogEntry {
+    /** @type {Uint8Array} */
+    #filenameBytes
+    /** @type {number} */
+    #filenameOffset
+    /** @type {number} */
+    #filenameLength
+
+    /**
+     * @param {string} filename
+     * @param {Uint8Array} filenameBytes
